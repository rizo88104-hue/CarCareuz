# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:  cp .env.example .env
# .env ni hech kimga yubormang va git'ga qo'shmang.

# Sayt manzili (mijozlarga yuboriladigan havolalar shu bilan boshlanadi)
APP_BASE_URL=https://carcare.uz

# Ma'lumotlar bazasi paroli (uzun, tasodifiy; masalan: openssl rand -base64 24)
DB_PASSWORD=

# Super admin — loyiha egasi (siz). Kamida 12 belgi, harf + raqam.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# Super admin faqat shu IP lardan kira oladi (ixtiyoriy). Vergul bilan, CIDR mumkin:
#   SUPERADMIN_ALLOWED_IPS=84.54.1.2, 10.0.0.0/8
# Bo'sh — cheklov yo'q. Diqqat: uy interneti IP si o'zgarib turadi, VPN yoki statik IP bo'lsa yoqing.
# Ikki bosqichli tasdiq (Telegram'ga 6 xonali kod) panelning o'zida yoqiladi: Super admin → 🔐 Xavfsizlik.
SUPERADMIN_ALLOWED_IPS=

# Telegram bot (@BotFather beradi). Bitta token faqat bitta serverda ishlasin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CarCareUzBot

# Eslatma necha kun oldin yuboriladi
REMINDER_DAYS=7
# Probeg bo'yicha eslatma: keyingi probegga necha km qolganda
REMINDER_KM=500

# Avtoservislardan oylik to'lov (obuna): narx so'mda, yangi servisga sinov kunlari, muddat tugagach imtiyoz kunlari
SUBSCRIPTION_PRICE=200000
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3

# SMS (Eskiz.uz) — ixtiyoriy, har SMS pullik
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
