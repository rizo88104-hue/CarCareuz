# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:  cp .env.example .env
# .env ni hech kimga yubormang va git'ga qo'shmang.

# Sayt manzili (mijozlarga yuboriladigan havolalar shu bilan boshlanadi)
APP_BASE_URL=https://carcare.uz

# Ma'lumotlar bazasi paroli (uzun, tasodifiy; masalan: openssl rand -base64 24)
DB_PASSWORD=

# Super admin — loyiha egasi (siz). Kamida 12 belgi, harf + raqam.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Telegram bot (@BotFather beradi). Bitta token faqat bitta serverda ishlasin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CarCareUzBot

# Eslatma necha kun oldin yuboriladi
REMINDER_DAYS=7

# SMS (Eskiz.uz) — ixtiyoriy, har SMS pullik
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
